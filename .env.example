# Gmail Browser MCP Configuration

# Option A: Session Cookie Mode
# Absolute or relative path to exported JSON cookies file for mail.google.com
GMAIL_COOKIES_PATH=./mail.google.com_cookies.json

# Option B: Persistent Chrome Profile Mode (Zero Cookie Exports)
# Set to 'true' to use a permanent Chrome user data profile stored on disk
GMAIL_USE_PROFILE=false
GMAIL_PROFILE_DIR=~/.gmail-mcp-profile

# Headless Execution (true) or visible browser window (false)
GMAIL_HEADLESS=true

# High-Speed Background Daemon Unix Socket Path
GMAIL_SOCKET_PATH=/tmp/gmail_mcp.sock

# Optional: Residential or corporate proxy (e.g. http://127.0.0.1:8080)
# GMAIL_PROXY=http://proxy.example.com:8080

# Optional: Timezone emulation (defaults to host system timezone)
# GMAIL_TIMEZONE=America/New_York

# Optional override for Google Account routing index (0 for /u/0, 1 for /u/1)
# GMAIL_ACCOUNT_INDEX=0

# Save debug screenshots upon action failures in .debug/
GMAIL_DEBUG_SCREENSHOTS=false
