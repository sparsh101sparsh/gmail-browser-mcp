# Gmail Browser MCP Configuration

# Absolute or relative path to exported Netscape/JSON cookies file for mail.google.com
GMAIL_COOKIES_PATH=./mail.google.com_cookies.json

# Run Chrome in headless mode (true) or visible browser window (false)
GMAIL_HEADLESS=true

# Optional override for Google Account routing index (0 for /u/0, 1 for /u/1).
# Defaults to auto-detection from cookie paths.
# GMAIL_ACCOUNT_INDEX=0

# Save debug screenshots upon action failures
GMAIL_DEBUG_SCREENSHOTS=false
